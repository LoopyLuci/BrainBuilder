# =============================================================================
# BrainBuilder + Luci root environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Do NOT commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Luci core
# -----------------------------------------------------------------------------
# Human-readable name for this Luci instance
LUCI_NAME=BrainBuilder Luci
# Default personality / tone for replies
LUCI_MOOD=helpful
# Default conversation/user identifiers when not provided by an adapter
LUCI_DEFAULT_CONVERSATION_ID=default
LUCI_DEFAULT_USER_ID=local-user
# Optional persistence root; falls back to `data/luci` inside the app data dir
LUCI_ROOT=
# Max tool execution duration in milliseconds (safety)
LUCI_TOOL_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Local model providers
# -----------------------------------------------------------------------------
# Ollama base URL (local LLM provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Preferred Ollama model id if not specified by task
OLLAMA_DEFAULT_MODEL=gemma2:9b
OLLAMA_API_KEY=
# OpenCode API key; also stored in OS keychain by the GUI when set via UI
OPENCODE_API_KEY=

# -----------------------------------------------------------------------------
# Model runtime / execution
# -----------------------------------------------------------------------------
# Number of GPU layers to offload for local GGUF inference
OMNIFORGE_N_GPU_LAYERS=0
# Context size for local GGUF inference
OMNIFORGE_CTX_SIZE=2048
# Preferred model host backend: auto, ollama, opencode
OMNIFORGE_MODEL_BACKEND=auto
# Override app data directory (defaults: %APPDATA%/OmniForge, ~/.local/share/omniforge, ~/Library/Application Support/OmniForge)
OMNIFORGE_DATA_DIR=
# Project root for self-edit allow-list (dev mode)
OMNIFORGE_ROOT=
# Python interpreter override for training/sandbox scripts
OMNIFORGE_PYTHON=
# Plugin search path(s), OS separator on Windows
OMNIFORGE_PLUGINS=

# -----------------------------------------------------------------------------
# Training / fine-tuning
# -----------------------------------------------------------------------------
# Sandbox wrapper for training script execution, if any
CONCIERGE_SANDBOX=
# Default training recipe preset: lora, qlora, full
TRAINING_DEFAULT_RECIPE=lora
# Default LoRA rank when not specified
TRAINING_DEFAULT_RANK=8
# Default LoRA alpha when not specified
TRAINING_DEFAULT_ALPHA=16
# Default learning rate when not specified
TRAINING_DEFAULT_LR=0.0003
# Default number of epochs when not specified
TRAINING_DEFAULT_EPOCHS=3

# -----------------------------------------------------------------------------
# Bot server / adapters
# -----------------------------------------------------------------------------
# Bind address for bot-server HTTP health/root endpoints
BOT_SERVER_HOST=127.0.0.1
BOT_SERVER_PORT=7780

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=
# Optional Telegram proxy: socks5://user:pass@host:port or http://host:port
TELEGRAM_PROXY=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# WhatsApp
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Signal
SIGNAL_CLI_HTTP_URL=http://127.0.0.1:8080
SIGNAL_CLI_NUMBER=
SIGNAL_WEBHOOK_SECRET=

# Matrix
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_USER_ID=@luci:matrix.org
MATRIX_PASSWORD=
MATRIX_ROOM_ID=

# Email
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Luci
EMAIL_INBOX_POLL_SECONDS=30

# SMS
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=
SMS_WEBHOOK_PATH=/sms/webhook

# Voice / calls
VOICE_ENABLED=false
VOICE_DEFAULT_PLATFORM=telegram

# -----------------------------------------------------------------------------
# Knowledge graph / memory
# -----------------------------------------------------------------------------
# Enable/disable persistent vector memory + KG on startup
LUCI_VECTOR_MEMORY_ENABLED=true
LUCI_KNOWLEDGE_GRAPH_ENABLED=true
# Embedding provider: local, ollama, opencode
LUCI_EMBEDDING_PROVIDER=ollama
LUCI_EMBEDDING_MODEL=nomic-embed-text
LUCI_EMBEDDING_DIMENSIONS=768
# Retrieval top-k
LUCI_RECALL_TOP_K=12
# Memory consolidation threshold (lower = more aggressive consolidation)
LUCI_CONSOLIDATION_MIN_SCORE=0.25

# -----------------------------------------------------------------------------
# Safety / approval
# -----------------------------------------------------------------------------
# Require human approval for high-risk tool categories: shell, network, fs_write
SAFETY_APPROVAL_REQUIRED=true
# Auto-approve low-risk categories when true
SAFETY_AUTO_APPROVE_LOW_RISK=true
# Max total tool budget per session
SAFETY_TOOL_BUDGET=1000
# Max cost units per single tool call
SAFETY_TOOL_COST_LIMIT=100
# Enable red-team harness in dev builds
SAFETY_REDTEAM_ENABLED=false
# Policy filter: allowlist or blocklist
SAFETY_POLICY_MODE=blocklist

# -----------------------------------------------------------------------------
# Self-improvement
# -----------------------------------------------------------------------------
# Enable real outcome logging and reflection loop
LUCI_SELF_IMPROVEMENT_ENABLED=true
# Max reflection entries to keep in working memory
LUCI_REFLECTION_WINDOW=200
# Prompt evolution cadence: after this many user turns
LUCI_PROMPT_EVOLUTION_EVERY_N=50
# Skill synthesis minimum confidence before proposing a new skill
LUCI_SKILL_SYNTHESIS_MIN_CONFIDENCE=0.8

# -----------------------------------------------------------------------------
# GUI / frontend
# -----------------------------------------------------------------------------
# Frontend dev server override; empty means bundled assets
VITE_DEV_SERVER_URL=
GUI_THEME=system
GUI_REDUCED_MOTION=false
GUI_LANGUAGE=en

# -----------------------------------------------------------------------------
# Platform / OS
# -----------------------------------------------------------------------------
# Force Windows-specific behaviors when auto-detect fails
FORCE_WINDOWS=false
FORCE_LINUX=false
FORCE_MACOS=false
# Windows SDK path for Tauri icon/packaging workflows
WINDOWS_SDK_PATH=
# Tauri bundler signing identity (macOS/Windows)
TAURI_SIGNING_IDENTITY=
TAURI_SIGNING_KEY=
TAURI_CERTIFICATE_PASSWORD=

# -----------------------------------------------------------------------------
# Logging / telemetry / debugging
# -----------------------------------------------------------------------------
RUST_LOG=brainbuilder_gui=info,bot_server=info,tauri=info
RUST_BACKTRACE=1
# Enable telemetry export when true
TELEMETRY_ENABLED=false
TELEMETRY_EXPORT_PATH=
# Enable raw network/body logging for adapters in dev
BOT_SERVER_DEBUG_ADAPTERS=false
